<?xml version="1.0" encoding="utf-8"?>
<!-- Simple launcher icon: brand teal tile with a white "R&F" monogram path stand-in. Replace with the official logo asset. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#279989" />
        </shape>
    </item>
    <item
        android:bottom="22dp"
        android:left="22dp"
        android:right="22dp"
        android:top="22dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/rf_logo_white" />
    </item>
</layer-list>
