# Copy to /opt/rhythmflow/.env on the server and fill in every value. This file is the ONLY place secrets live.
# Never commit the real .env.  Lines starting with # are comments.

# --- Web address and image -------------------------------------------------------------------------------
# The https address people use. Either your own domain, or the server's IP with dashes + .sslip.io
# (for IP 41.0.0.1 use  41-0-0-1.sslip.io ).  No https:// here.
API_DOMAIN=CHANGE-ME
# Set automatically by the deployment pipeline; leave as is.
API_IMAGE=ghcr.io/samirm91011/rhythmflow-api:latest

# --- Database --------------------------------------------------------------------------------------------
# Any long password. Letters and numbers only (no spaces, ;, = or quotes) keeps the connection string safe.
DB_PASSWORD=CHANGE-ME

# --- Secrets for login tokens and signed video links (two DIFFERENT random values, 48+ characters) ------
Jwt__Key=CHANGE-ME
Media__SigningKey=CHANGE-ME

# --- PayFast (sandbox now; change for the client's live account at launch) -------------------------------
PayFast__Sandbox=true
PayFast__MerchantId=CHANGE-ME
PayFast__MerchantKey=CHANGE-ME
PayFast__Passphrase=CHANGE-ME
# https:// + the API_DOMAIN above, no slash at the end
PayFast__PublicBaseUrl=https://CHANGE-ME
PayFast__ValidateWithServer=true

# --- Email (Gmail SMTP). If the server blocks port 587, switch to Brevo: see docs/XNEELO-SETUP.md ---------
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__User=CHANGE-ME
Smtp__Password=CHANGE-ME
Smtp__FromAddress=CHANGE-ME
Admin__AlertEmails__0=CHANGE-ME

# --- Demo accounts created on first start (delete them at launch) ----------------------------------------
Seed__Users__0__FullName=Rhythm Admin
Seed__Users__0__Username=admin
Seed__Users__0__Email=admin@rhythmandflow.test
Seed__Users__0__Password=CHANGE-ME
Seed__Users__0__Role=ADMIN
Seed__Users__1__FullName=Alex Demo
Seed__Users__1__Username=alex
Seed__Users__1__Email=alex@rhythmandflow.test
Seed__Users__1__Password=CHANGE-ME
Seed__Users__1__Role=CUSTOMER
