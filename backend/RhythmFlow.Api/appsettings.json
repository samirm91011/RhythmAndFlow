{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "Default": "Data Source=rhythmflow.db" },
  "Jwt": { "Issuer": "rhythmflow", "Audience": "rhythmflow-app", "ExpiryMinutes": 10080 },
  "Media": { "LocalFolder": "media" },
  "PayFast": { "Sandbox": true, "ReturnPath": "/payfast/return", "CancelPath": "/payfast/cancel", "ValidateWithServer": true },
  "Booking": { "CancelCutoffHours": 2 },
  "RateLimit": { "AuthPerMinute": 20 }
}

